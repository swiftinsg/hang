rules_version = '2';

// Hang — Firestore security rules (hardened).
//
// The privacy promise is "groups see WHEN you are busy, never WHY". The
// availability subcollection remains the enforcement point, but group documents
// are no longer writable by every signed-in user: otherwise anyone could add
// themselves to a group and unlock every member's busy intervals.
//
// Group `list` reads stay open because invite-code lookup happens before a
// user is a member, and account deletion scans groups for stale identity data.
// Rules v2 cannot inspect query WHERE clauses, so this cannot be narrowed
// further without a separate invite-code index / Admin SDK migration.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function selfRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // `groups/{groupID}.people` holds references to `users/<uid>` documents.
    function isGroupMember(groupID) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupID))
             .data.people
             .hasAny([selfRef()]);
    }

    // ------------------------------------------------- group-document helpers

    function hasGroupBasics(data) {
      return data.keys().hasAll(['inviteCode', 'name', 'desc', 'people'])
        && data.inviteCode is string
        && data.inviteCode.size() > 0
        && data.inviteCode.size() <= 32
        && data.name is string
        && data.desc is string
        && data.people is list;
    }

    function scalarGroupFieldsUnchanged(before, after) {
      return after.inviteCode == before.inviteCode
        && after.name == before.name
        && after.desc == before.desc
        && after.get('eventColor', '') == before.get('eventColor', '')
        && after.keys().hasOnly(
             ['inviteCode', 'name', 'desc', 'people',
              'memberNames', 'memberProfilePictures', 'eventColor']
           )
        && before.keys().hasOnly(
             ['inviteCode', 'name', 'desc', 'people',
              'memberNames', 'memberProfilePictures', 'eventColor']
           );
    }

    function onlyOwnMapKeysChanged(afterMap, beforeMap, uid) {
      return afterMap.diff(beforeMap).affectedKeys().hasOnly([uid]);
    }

    function onlyOwnMapKeysRemoved(afterMap, beforeMap, uid) {
      let changes = afterMap.diff(beforeMap);
      return changes.affectedKeys().hasOnly([uid])
        && changes.addedKeys().size() == 0
        && changes.changedKeys().size() == 0;
    }

    function validNewGroup() {
      let data = request.resource.data;
      return hasGroupBasics(data)
        && data.keys().hasOnly(
             ['inviteCode', 'name', 'desc', 'people',
              'memberNames', 'memberProfilePictures', 'eventColor']
           )
        && data.get('eventColor', '') is string
        && data.get('eventColor', '').size() > 0
        && data.get('eventColor', '').size() <= 16
        && data.people == [selfRef()]
        && data.get('memberNames', {}).keys().hasOnly([request.auth.uid])
        && data.get('memberProfilePictures', {}).keys().hasOnly([request.auth.uid]);
    }

    // A non-member may join by adding only themselves and only their own
    // name/avatar entries (GroupStore.joinGroup).
    function validJoin() {
      let before = resource.data;
      let after = request.resource.data;
      let self = selfRef();
      return hasGroupBasics(before)
        && hasGroupBasics(after)
        && scalarGroupFieldsUnchanged(before, after)
        && !before.people.hasAny([self])
        && after.people.hasAny([self])
        && after.people.hasAll(before.people)
        && after.people.size() == before.people.size() + 1
        && onlyOwnMapKeysChanged(
             after.get('memberNames', {}),
             before.get('memberNames', {}),
             request.auth.uid)
        && onlyOwnMapKeysChanged(
             after.get('memberProfilePictures', {}),
             before.get('memberProfilePictures', {}),
             request.auth.uid);
    }

    // Leaving: remove only yourself and optionally erase only your own entries.
    function validSelfExit() {
      let before = resource.data;
      let after = request.resource.data;
      let self = selfRef();
      return hasGroupBasics(before)
        && hasGroupBasics(after)
        && scalarGroupFieldsUnchanged(before, after)
        && before.people.hasAny([self])
        && !after.people.hasAny([self])
        && before.people.hasAll(after.people)
        && before.people.size() == after.people.size() + 1
        && onlyOwnMapKeysChanged(
             after.get('memberNames', {}),
             before.get('memberNames', {}),
             request.auth.uid)
        && onlyOwnMapKeysChanged(
             after.get('memberProfilePictures', {}),
             before.get('memberProfilePictures', {}),
             request.auth.uid);
    }

    // A current member refreshing their own copied name/avatar.
    function validMemberProfileRefresh() {
      let before = resource.data;
      let after = request.resource.data;
      return hasGroupBasics(before)
        && hasGroupBasics(after)
        && scalarGroupFieldsUnchanged(before, after)
        && after.people == before.people
        && onlyOwnMapKeysChanged(
             after.get('memberNames', {}),
             before.get('memberNames', {}),
             request.auth.uid)
        && onlyOwnMapKeysChanged(
             after.get('memberProfilePictures', {}),
             before.get('memberProfilePictures', {}),
             request.auth.uid);
    }

    // A member changing the colour used for this group's shared events.
    function validGroupColorChange() {
      let before = resource.data;
      let after = request.resource.data;
      return hasGroupBasics(before)
        && hasGroupBasics(after)
        && scalarGroupFieldsUnchangedIgnoringColor(before, after)
        && after.diff(before).affectedKeys().hasOnly(['eventColor'])
        && after.eventColor is string
        && after.eventColor.size() > 0
        && after.eventColor.size() <= 16;
    }

    // A member renaming the group. Only `name` may change; it stays a
    // non-empty string, capped at 100 characters, matching the client check.
    function validGroupRename() {
      let before = resource.data;
      let after = request.resource.data;
      return isGroupMember(resource.id)
        && hasGroupBasics(after)
        && after.diff(before).affectedKeys().hasOnly(['name'])
        && after.name is string
        && after.name.size() > 0
        && after.name.size() <= 100;
    }

    // Same shape as scalarGroupFieldsUnchanged, but allows only eventColor.
    function scalarGroupFieldsUnchangedIgnoringColor(before, after) {
      return after.inviteCode == before.inviteCode
        && after.name == before.name
        && after.desc == before.desc
        && after.people == before.people
        && after.get('memberNames', {}) == before.get('memberNames', {})
        && after.get('memberProfilePictures', {})
             == before.get('memberProfilePictures', {})
        && after.keys().hasOnly(
             ['inviteCode', 'name', 'desc', 'people',
              'memberNames', 'memberProfilePictures', 'eventColor']
           )
        && before.keys().hasOnly(
             ['inviteCode', 'name', 'desc', 'people',
              'memberNames', 'memberProfilePictures', 'eventColor']
           );
    }

    // Account deletion may erase only the caller's stale entries from groups
    // they are no longer in (AccountDeletionController).
    function validStaleSelfCleanup() {
      let before = resource.data;
      let after = request.resource.data;
      let self = selfRef();
      return hasGroupBasics(before)
        && hasGroupBasics(after)
        && scalarGroupFieldsUnchanged(before, after)
        && after.people == before.people
        && !before.people.hasAny([self])
        && onlyOwnMapKeysRemoved(
             after.get('memberNames', {}),
             before.get('memberNames', {}),
             request.auth.uid)
        && onlyOwnMapKeysRemoved(
             after.get('memberProfilePictures', {}),
             before.get('memberProfilePictures', {}),
             request.auth.uid);
    }

    function validEventPayload() {
      let data = request.resource.data;
      return data.keys().hasOnly(['name', 'desc', 'location', 'time', 'endTime'])
        && data.name is string
        && data.name.size() <= 200
        && data.desc is string
        && data.desc.size() <= 2000
        && data.get('location', '') is string
        && data.time is timestamp
        && (!data.keys().hasAny(['endTime']) || data.endTime is timestamp);
    }

    // --------------------------------------------------------------- profiles
    match /users/{uid} {
      // No client flow reads another user's document. Names and avatars are
      // copied into group documents instead.
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if signedIn() && request.auth.uid == uid;

      match /calendar/{eventID} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ----------------------------------------------------------------- groups
    match /groups/{groupID} {
      // Direct reads by document ID are member-only. No current client flow
      // reads a group document directly; rule-level get() calls are unaffected.
      allow get: if signedIn() && isGroupMember(groupID);

      // Invite-code lookup and deletion cleanup need unscoped list queries.
      allow list: if signedIn();

      allow create: if signedIn() && validNewGroup();

      // Non-member branches come first so a join is never blocked by the
      // member-only get() inside isGroupMember().
      allow update: if signedIn() && (
        validJoin()
        || validSelfExit()
        || validStaleSelfCleanup()
        || (isGroupMember(groupID) && validMemberProfileRefresh())
        || (isGroupMember(groupID) && validGroupColorChange())
        || (isGroupMember(groupID) && validGroupRename())
      );

      // Groups are shared history; no client flow deletes a group document.
      allow delete: if false;

      // Group events are shared with the whole group by design.
      match /events/{eventID} {
        allow read: if isGroupMember(groupID);
        allow create, update: if isGroupMember(groupID) && validEventPayload();
        allow delete: if isGroupMember(groupID);
      }

      // --------------------------------------------------------- availability
      //
      // THE PRIVACY BOUNDARY.
      //
      // Exactly three top-level fields are allowed, and none can carry an
      // event name. `days` is capped at 40 entries. Rules cannot iterate lists,
      // so day-entry contents remain unvalidated by rules; the client ignores
      // extra keys. Closing that gap fully needs an Admin SDK Cloud Function.
      match /availability/{uid} {
        function validPayload() {
          let data = request.resource.data;
          return data.keys().hasAll(['timezoneIdentifier', 'updatedAt', 'days'])
            && data.keys().hasOnly(['timezoneIdentifier', 'updatedAt', 'days'])
            && data.timezoneIdentifier is string
            && data.timezoneIdentifier.size() > 0
            && data.timezoneIdentifier.size() <= 64
            && data.updatedAt == request.time
            && data.days is list
            && data.days.size() <= 40;
        }

        allow read: if isGroupMember(groupID);

        // Only the owner may publish their own busy times. Membership is
        // intentionally not re-checked here: a live group write and the group
        // listener can race, and a failed sync used to surface as
        // "missing or insufficient permission". Reads above remain member-only,
        // so this does not expose anyone's intervals to non-members.
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && validPayload();

        // Works after leaving / during account deletion.
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
