rules_version = '2';

// Hang — Firestore security rules (hardened).
//
// The privacy promise is "groups see WHEN you are busy, never WHY". The
// availability subcollection remains the enforcement point, but group documents
// are no longer writable by every signed-in user: otherwise anyone could add
// themselves to a group and unlock every member's busy intervals.
//
// Group `list` reads stay open because invite-code lookup happens before a
// user is a member, and account deletion scans groups for stale identity data.
// Rules v2 cannot inspect query WHERE clauses, so this cannot be narrowed
// further without a separate invite-code index / Admin SDK migration.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function selfRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // `groups/{groupID}.people` holds references to `users/<uid>` documents.
    function isGroupMember(groupID) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupID))
             .data.people
             .hasAny([selfRef()]);
    }

    // The recipient of an edit notice must belong to the same group as the
    // sender. Without this, any member could write a notice into any inbox.
    function isGroupMemberUID(groupID, uid) {
      return signedIn()
        && get(/databases/$(database)/documents/groups/$(groupID))
             .data.people
             .hasAny([/databases/$(database)/documents/users/$(uid)]);
    }

    // Group map values are copied into every member's view of the group. Only
    // strings of a bounded size may be written, otherwise decoding fails and
    // the whole group disappears for everyone.
    function validOwnNameValue(map) {
      return map.get(request.auth.uid, '') is string
        && map.get(request.auth.uid, '').size() <= 100;
    }

    function validOwnPictureValue(map) {
      return map.get(request.auth.uid, '') is string
        && map.get(request.auth.uid, '').size() <= 32;
    }

    // ------------------------------------------------- group-document helpers

    function hasGroupBasics(data) {
      return data.keys().hasAll(['inviteCode', 'name', 'desc', 'people'])
        && data.inviteCode is string
        && data.inviteCode.size() > 0
        && data.inviteCode.size() <= 32
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.desc is string
        && data.desc.size() <= 2000
        && data.people is list;
    }

    function groupKeys() {
      return ['inviteCode', 'name', 'desc', 'people',
              'memberNames', 'memberProfilePictures', 'eventColor'];
    }

    function validColorValue(value) {
      return value is string && value.size() > 0 && value.size() <= 16;
    }

    // Older groups were created before `eventColor`, `memberNames`, and
    // `memberProfilePictures`, and some have extra fields from older versions.
    // Updates validate the fields the app actually uses; unknown existing keys
    // are allowed to remain, and the operation branches below prevent new ones
    // from being introduced. New documents are still strictly checked.
    function validGroupShape(data) {
      return hasGroupBasics(data)
        && (!data.keys().hasAny(['eventColor']) || validColorValue(data.eventColor))
        && data.get('memberNames', {}) is map
        && data.get('memberProfilePictures', {}) is map;
    }

    function changedGroupKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyOwnMapKeysChanged(afterMap, beforeMap, uid) {
      return afterMap.diff(beforeMap).affectedKeys().hasOnly([uid]);
    }

    function onlyOwnMapKeysRemoved(afterMap, beforeMap, uid) {
      let changes = afterMap.diff(beforeMap);
      return changes.affectedKeys().hasOnly([uid])
        && changes.addedKeys().size() == 0
        && changes.changedKeys().size() == 0;
    }

    function validNewGroup() {
      let data = request.resource.data;
      return hasGroupBasics(data)
        && data.keys().hasOnly(groupKeys())
        && validColorValue(data.get('eventColor', ''))
        && data.people == [selfRef()]
        && data.get('memberNames', {}).keys().hasOnly([request.auth.uid])
        && data.get('memberProfilePictures', {}).keys().hasOnly([request.auth.uid])
        && validOwnNameValue(data.get('memberNames', {}))
        && validOwnPictureValue(data.get('memberProfilePictures', {}));
    }

    // Shape and the caller's own map values are checked once by the update
    // rule, so each operation below only needs to prove its own change.
    // Colour changes are handled by their own branch first; no other branch may
    // touch `eventColor`.

    // A non-member may join by adding only themselves and only their own
    // name/avatar entries (GroupStore.joinGroup).
    function validJoin() {
      let before = resource.data;
      let after = request.resource.data;
      let self = selfRef();
      return changedGroupKeys().hasOnly(
               ['people', 'memberNames', 'memberProfilePictures'])
        && !before.people.hasAny([self])
        && after.people.hasAny([self])
        && after.people.hasAll(before.people)
        && after.people.size() == before.people.size() + 1
        && onlyOwnMapKeysChanged(
             after.get('memberNames', {}),
             before.get('memberNames', {}),
             request.auth.uid)
        && onlyOwnMapKeysChanged(
             after.get('memberProfilePictures', {}),
             before.get('memberProfilePictures', {}),
             request.auth.uid);
    }

    // Leaving: remove only yourself and optionally erase only your own entries.
    function validSelfExit() {
      let before = resource.data;
      let after = request.resource.data;
      let self = selfRef();
      return changedGroupKeys().hasOnly(
               ['people', 'memberNames', 'memberProfilePictures'])
        && before.people.hasAny([self])
        && !after.people.hasAny([self])
        && before.people.hasAll(after.people)
        && before.people.size() == after.people.size() + 1
        && onlyOwnMapKeysChanged(
             after.get('memberNames', {}),
             before.get('memberNames', {}),
             request.auth.uid)
        && onlyOwnMapKeysChanged(
             after.get('memberProfilePictures', {}),
             before.get('memberProfilePictures', {}),
             request.auth.uid);
    }

    // A current member refreshing their own copied name/avatar.
    function validMemberProfileRefresh() {
      let before = resource.data;
      let after = request.resource.data;
      return changedGroupKeys().hasOnly(
               ['memberNames', 'memberProfilePictures'])
        && onlyOwnMapKeysChanged(
             after.get('memberNames', {}),
             before.get('memberNames', {}),
             request.auth.uid)
        && onlyOwnMapKeysChanged(
             after.get('memberProfilePictures', {}),
             before.get('memberProfilePictures', {}),
             request.auth.uid);
    }

    // A member changing the colour used for this group's shared events.
    // This branch is deliberately self-contained: legacy groups can have
    // missing or extra fields, and none of those may block the picker.
    function validGroupColorChange(groupID) {
      let changed = changedGroupKeys();
      return isGroupMember(groupID)
        && changed.hasOnly(['eventColor'])
        && changed.hasAny(['eventColor'])
        && request.resource.data.eventColor is string
        && request.resource.data.eventColor in [
             'automatic', 'orange', 'red', 'pink', 'purple',
             'blue', 'cyan', 'green', 'yellow'
           ];
    }

    // A member renaming the group.
    function validGroupRename() {
      return changedGroupKeys().hasOnly(['name']);
    }

    // Account deletion may erase only the caller's stale entries from groups
    // they are no longer in (AccountDeletionController).
    function validStaleSelfCleanup() {
      let before = resource.data;
      let after = request.resource.data;
      let self = selfRef();
      return changedGroupKeys().hasOnly(
               ['memberNames', 'memberProfilePictures'])
        && after.people == before.people
        && !before.people.hasAny([self])
        && onlyOwnMapKeysRemoved(
             after.get('memberNames', {}),
             before.get('memberNames', {}),
             request.auth.uid)
        && onlyOwnMapKeysRemoved(
             after.get('memberProfilePictures', {}),
             before.get('memberProfilePictures', {}),
             request.auth.uid);
    }

    function validEventPayload() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'desc', 'location', 'time', 'endTime'])
        && data.keys().hasOnly(['name', 'desc', 'location', 'time', 'endTime'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && data.desc is string
        && data.desc.size() <= 2000
        && data.location is string
        && data.location.size() <= 200
        && data.time is timestamp
        && data.endTime is timestamp
        && data.endTime >= data.time;
    }

    // --------------------------------------------------------------- profiles
    match /users/{uid} {
      // No client flow reads another user's document. Names and avatars are
      // copied into group documents instead.
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if signedIn() && request.auth.uid == uid;

      match /calendar/{eventID} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // Edit notices are written by a group member into another member of the
      // SAME group's inbox. The recipient alone can read or clear their inbox.
      match /notifications/{notificationID} {
        function validEditNoticeShape() {
          let data = request.resource.data;
          return data.keys().hasOnly(
                   ['kind', 'title', 'body', 'groupID', 'eventID', 'createdAt'])
            && data.kind == 'eventEdited'
            && data.groupID is string
            && data.groupID.size() > 0
            && data.eventID is string
            && data.eventID.size() > 0
            && data.title is string
            && data.title.size() > 0
            && data.title.size() <= 300
            && data.body is string
            && data.body.size() > 0
            && data.body.size() <= 500
            && data.createdAt is timestamp
            && data.createdAt == request.time;
        }

        // The notice must describe a real event in that group, and its text must
        // be derived from that event and group name. A member cannot invent a
        // message by passing arbitrary strings to the fan-out function.
        function validEditNoticeContent() {
          let data = request.resource.data;
          let groupPath = /databases/$(database)/documents/groups/$(data.groupID);
          let eventPath = /databases/$(database)/documents/groups/$(data.groupID)/events/$(data.eventID);
          return exists(eventPath)
            && data.title == get(eventPath).data.name + ' has been edited'
            && data.body == get(eventPath).data.name
                 + ' in group ' + get(groupPath).data.name
                 + ' has been edited';
        }

        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && validEditNoticeShape()
          && isGroupMember(request.resource.data.groupID)
          && isGroupMemberUID(request.resource.data.groupID, uid)
          && validEditNoticeContent();
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // ----------------------------------------------------------------- groups
    match /groups/{groupID} {
      // Direct reads by document ID are member-only. The notification fan-out
      // reads the group document to resolve its members, so this stays a
      // member-only get().
      allow get: if signedIn() && isGroupMember(groupID);

      // Invite-code lookup and deletion cleanup need unscoped list queries.
      allow list: if signedIn();

      allow create: if signedIn() && validNewGroup();

      // A colour change is checked first and on its own. It must not depend on
      // the rest of the document's shape: older groups can have missing or
      // extra fields, and those must never stop the picker from saving.
      // Every other update still validates shape and this user's copied values
      // once, then proves which supported operation is being performed.
      allow update: if signedIn() && (
        validGroupColorChange(groupID)
        || (
          validGroupShape(resource.data)
          && validGroupShape(request.resource.data)
          && validOwnNameValue(request.resource.data.get('memberNames', {}))
          && validOwnPictureValue(request.resource.data.get('memberProfilePictures', {}))
          && (
            (isGroupMember(groupID) && (
              validGroupRename()
              || validMemberProfileRefresh()
              || validSelfExit()
            ))
            || validJoin()
            || validStaleSelfCleanup()
          )
        )
      );

      // Groups are shared history; no client flow deletes a group document.
      allow delete: if false;

      // Group events are shared with the whole group by design.
      match /events/{eventID} {
        allow read: if isGroupMember(groupID);
        allow create, update: if isGroupMember(groupID) && validEventPayload();
        allow delete: if isGroupMember(groupID);
      }

      // --------------------------------------------------------- availability
      //
      // THE PRIVACY BOUNDARY.
      //
      // Exactly three top-level fields are allowed, and none can carry an
      // event name. `days` is capped at 40 entries. Rules cannot iterate lists,
      // so day-entry contents remain unvalidated by rules; the client ignores
      // extra keys. Closing that gap fully needs an Admin SDK Cloud Function.
      match /availability/{uid} {
        function validPayload() {
          let data = request.resource.data;
          return data.keys().hasAll(['timezoneIdentifier', 'updatedAt', 'days'])
            && data.keys().hasOnly(['timezoneIdentifier', 'updatedAt', 'days'])
            && data.timezoneIdentifier is string
            && data.timezoneIdentifier.size() > 0
            && data.timezoneIdentifier.size() <= 64
            && data.updatedAt == request.time
            && data.days is list
            && data.days.size() <= 40;
        }

        allow read: if isGroupMember(groupID);

        // Only the owner may publish their own busy times, and only while they
        // are still a member. The client drops a group from its publish list as
        // soon as leave/deletion removes it, so a denied race is a no-op rather
        // than a stale republish. Reads above remain member-only too.
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && isGroupMember(groupID)
          && validPayload();

        // Works after leaving / during account deletion.
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
